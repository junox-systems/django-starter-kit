# HyperDX browser SDK (session replay + frontend tracing)
# Set these to enable frontend observability in clickstack (self-hosted HyperDX).
# Leave VITE_HYPERDX_URL empty to disable.

# ClickStack / HyperDX API URL (e.g., http://localhost:8080 for local clickstack)
VITE_HYPERDX_URL=

# Optional: ingestion API key (empty for self-hosted clickstack)
VITE_HYPERDX_API_KEY=

# Optional: service name (default: django-starter-kit-frontend)
VITE_HYPERDX_SERVICE=django-starter-kit-frontend
